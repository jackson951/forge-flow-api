// FlowForge domain model. Design decisions: docs/backend/02-DATABASE-DOMAIN-MODEL.md
//
// Conventions: UUID ids, timestamptz(3) timestamps, createdAt everywhere, updatedAt on
// mutable rows. Every tenant-owned row carries workspaceId or hangs off an immutable
// parent that does (StepRun → WorkflowRun, IntegrationCredential → IntegrationConnection).
// Constraints Prisma cannot express (WorkflowVersion immutability trigger, lowercase email
// check) live as raw SQL in the migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum IntegrationProviderKey {
  GITHUB
  MICROSOFT
  SLACK
  /// Non-production webhook provider for end-to-end tests (Part 09); never enabled in production.
  TEST
  /// Generic HTTP connections (Part 24): API-key / bearer / basic credentials, no OAuth.
  HTTP
}

enum ConnectionStatus {
  CONNECTED
  NEEDS_ATTENTION
  DISCONNECTED
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TriggerSource {
  WEBHOOK
  MANUAL
  RETRY
  SCHEDULE
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StepStatus {
  PENDING
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ErrorCategory {
  VALIDATION
  AUTHORIZATION
  PROVIDER_AUTH
  PROVIDER_RATE_LIMIT
  PROVIDER_TIMEOUT
  TRANSIENT_INFRASTRUCTURE
  PERMANENT_PROVIDER_ERROR
  UNCERTAIN_OUTCOME
  CANCELLED
  INTERNAL
}

enum WebhookDeliveryStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

// ── Identity ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Stored lower-cased (enforced by CHECK constraint).
  email        String   @unique
  name         String
  /// argon2id hash. Never selected into API responses.
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  memberships       WorkspaceMember[]
  refreshTokens     RefreshToken[]
  createdWorkflows  Workflow[]              @relation("WorkflowCreatedBy")
  publishedVersions WorkflowVersion[]       @relation("VersionPublishedBy")
  connections       IntegrationConnection[] @relation("ConnectionCreatedBy")
  oauthStates       OAuthState[]
  auditEvents       AuditEvent[]            @relation("AuditActor")
}

/// Opaque refresh tokens, stored hashed. A rotation chain shares one familyId so
/// reuse of a rotated token can revoke the whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @unique @db.Uuid
  userAgent    String?
  ipHash       String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
}

// ── Tenancy ──────────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members     WorkspaceMember[]
  workflows   Workflow[]
  versions    WorkflowVersion[]
  triggers    WorkflowTrigger[]
  schedules   WorkflowSchedule[]
  runs        WorkflowRun[]
  connections IntegrationConnection[]
  oauthStates OAuthState[]
  deliveries  WebhookDelivery[]
  auditEvents AuditEvent[]
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ── Workflows ────────────────────────────────────────────────────────────────

/// Mutable workflow: metadata + the single editable draft.
model Workflow {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @db.Uuid
  name            String
  description     String?
  status          WorkflowStatus @default(DRAFT)
  draftDefinition Json
  /// Optimistic-concurrency counter for draft saves.
  draftRevision   Int            @default(0)
  activeVersionId String?        @unique @db.Uuid
  createdById     String?        @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activeVersion WorkflowVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions      WorkflowVersion[] @relation("WorkflowVersions")
  trigger       WorkflowTrigger?
  schedule      WorkflowSchedule?
  runs          WorkflowRun[]

  @@index([workspaceId, status, updatedAt])
}

/// Immutable published snapshot (UPDATE of the snapshot columns is rejected by a trigger).
/// Deleting a version that runs reference is blocked (NoAction on WorkflowRun).
model WorkflowVersion {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  workflowId     String   @db.Uuid
  version        Int
  schemaVersion  Int
  definition     Json
  /// sha256 of the canonical JSON definition.
  definitionHash String
  publishedAt    DateTime @default(now()) @db.Timestamptz(3)
  publishedById  String?  @db.Uuid

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    Workflow           @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  publishedBy User?              @relation("VersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  activeFor   Workflow?          @relation("ActiveVersion")
  triggers    WorkflowTrigger[]
  schedules   WorkflowSchedule[]
  runs        WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workspaceId])
}

/// Routing index for webhook triggers of a workflow's active version.
/// Rewritten on publish/archive in the same transaction.
model WorkflowTrigger {
  id                String                 @id @default(uuid()) @db.Uuid
  workspaceId       String                 @db.Uuid
  workflowId        String                 @unique @db.Uuid
  workflowVersionId String                 @db.Uuid
  provider          IntegrationProviderKey
  eventType         String
  /// Provider-specific routing key, e.g. "<installationId>:owner/repo".
  resourceKey       String
  connectionId      String?                @db.Uuid
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow   Workflow               @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version    WorkflowVersion        @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([provider, eventType, resourceKey])
  @@index([workspaceId])
}

/// Time trigger of a workflow's active version (Part 23). Written on publish/archive/unarchive
/// in the same transaction; the maintenance job turns due occurrences into runs.
model WorkflowSchedule {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @db.Uuid
  workflowId        String    @unique @db.Uuid
  workflowVersionId String    @db.Uuid
  /// Compiled 5-field cron expression, evaluated in `timezone`.
  cron              String
  /// IANA timezone, e.g. "Africa/Johannesburg".
  timezone          String
  /// The node's friendly schedule config as published.
  config            Json
  /// Human-readable summary, e.g. "Weekdays at 07:00 (Africa/Johannesburg)".
  description       String
  /// False while the workflow is archived.
  active            Boolean   @default(true)
  nextRunAt         DateTime? @db.Timestamptz(3)
  lastOccurrenceAt  DateTime? @db.Timestamptz(3)
  /// Run created for the last occurrence (no foreign key: retention may delete runs).
  lastRunId         String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

  // The evaluator's "due" scan: active schedules by next occurrence.
  @@index([active, nextRunAt])
  @@index([workspaceId])
  @@index([workflowVersionId])
}

// ── Execution history ────────────────────────────────────────────────────────

model WorkflowRun {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @db.Uuid
  workflowId        String         @db.Uuid
  workflowVersionId String         @db.Uuid
  status            RunStatus      @default(QUEUED)
  triggerSource     TriggerSource
  /// Unique per workspace, e.g. "GITHUB:<deliveryId>:<workflowId>" or a random UUID for manual runs.
  idempotencyKey    String
  webhookDeliveryId String?        @db.Uuid
  retryOfRunId      String?        @db.Uuid
  /// Sanitised trigger payload (no secrets).
  triggerInput      Json?
  correlationId     String?
  attemptCount      Int            @default(0)
  lastErrorCategory ErrorCategory?
  errorMessage      String?
  lockedBy          String?
  cancelRequestedAt DateTime?      @db.Timestamptz(3)
  /// Set when retention cleared the steps' stored input/output (Part 21).
  payloadsTrimmedAt DateTime?      @db.Timestamptz(3)
  queuedAt          DateTime       @default(now()) @db.Timestamptz(3)
  startedAt         DateTime?      @db.Timestamptz(3)
  completedAt       DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement): a workflow/version with runs cannot be deleted on
  // its own, but deleting the whole workspace cascades through runs and versions together.
  workflow        Workflow         @relation(fields: [workflowId], references: [id], onDelete: NoAction)
  version         WorkflowVersion  @relation(fields: [workflowVersionId], references: [id], onDelete: NoAction)
  webhookDelivery WebhookDelivery? @relation(fields: [webhookDeliveryId], references: [id], onDelete: SetNull)
  retryOf         WorkflowRun?     @relation("RunRetries", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries         WorkflowRun[]    @relation("RunRetries")
  steps           StepRun[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([workflowId, createdAt])
  @@index([status, queuedAt])
  @@index([webhookDeliveryId])
  // Deleting runs sets retryOfRunId to NULL on their retries: without this index every
  // deleted run costs a full scan (Part 21).
  @@index([retryOfRunId])
  // Retention: oldest untrimmed runs first, and oldest runs overall.
  @@index([payloadsTrimmedAt, createdAt])
  @@index([createdAt])
}

/// One row per node per run; retries of the same node increment attemptCount.
model StepRun {
  id              String         @id @default(uuid()) @db.Uuid
  runId           String         @db.Uuid
  nodeKey         String
  nodeType        String
  sequence        Int
  status          StepStatus     @default(PENDING)
  attemptCount    Int            @default(0)
  sanitizedInput  Json?
  sanitizedOutput Json?
  errorCategory   ErrorCategory?
  errorMessage    String?
  /// Provider-side identifier of the side effect (e.g. Slack message ts).
  externalRef     String?
  startedAt       DateTime?      @db.Timestamptz(3)
  completedAt     DateTime?      @db.Timestamptz(3)
  durationMs      Int?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeKey])
  @@index([runId, sequence])
}

// ── Integrations ─────────────────────────────────────────────────────────────

/// Connected external account — metadata only. Secrets live in IntegrationCredential.
model IntegrationConnection {
  id                String                 @id @default(uuid()) @db.Uuid
  workspaceId       String                 @db.Uuid
  provider          IntegrationProviderKey
  status            ConnectionStatus       @default(CONNECTED)
  /// Provider account id (GitHub installation id, Slack team id, Entra object id).
  externalAccountId String
  accountLabel      String?
  scopes            String[]
  metadata          Json?
  createdById       String?                @db.Uuid
  lastUsedAt        DateTime?              @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User?                  @relation("ConnectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  credential IntegrationCredential?
  triggers   WorkflowTrigger[]

  @@unique([workspaceId, provider, externalAccountId])
  @@index([workspaceId])
}

/// AES-256-GCM ciphertext only. Kept in its own table so a default include/select of a
/// connection can never carry secrets.
model IntegrationCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  connectionId          String    @unique @db.Uuid
  keyId                 String
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  /// HTTP connections (Part 24): AES-GCM sealed JSON of the auth secrets.
  encryptedPayload      String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

/// Single-use OAuth state (stored as hash) bound to user, workspace and provider.
model OAuthState {
  id                    String                 @id @default(uuid()) @db.Uuid
  stateHash             String                 @unique
  provider              IntegrationProviderKey
  userId                String                 @db.Uuid
  workspaceId           String                 @db.Uuid
  encryptedCodeVerifier String?
  expiresAt             DateTime               @db.Timestamptz(3)
  consumedAt            DateTime?              @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Verified inbound provider delivery. Unique (provider, deliveryId) is the idempotency guard.
/// workspaceId is nullable: a delivery is stored before routing and may match no workspace.
model WebhookDelivery {
  id           String                 @id @default(uuid()) @db.Uuid
  provider     IntegrationProviderKey
  deliveryId   String
  eventType    String
  workspaceId  String?                @db.Uuid
  status       WebhookDeliveryStatus  @default(RECEIVED)
  /// Normalised, size-limited event (never the raw body or headers).
  payload      Json?
  errorMessage String?
  receivedAt   DateTime               @default(now()) @db.Timestamptz(3)
  processedAt  DateTime?              @db.Timestamptz(3)

  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  runs      WorkflowRun[]

  @@unique([provider, deliveryId])
  @@index([receivedAt])
}

/// Append-only record of security-relevant actions. workspaceId is null for
/// account-level events (e.g. failed login).
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
}
