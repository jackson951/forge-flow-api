# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173
# Defaults to true outside production, false in production
SWAGGER_ENABLED=true

# ── Database ─────────────────────────────────────────
# Local development values only (docker compose). Compose maps Postgres to host port 5433.
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
POSTGRES_DB=flowforge
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5433/flowforge?schema=public
# Used by the api/worker containers in the compose "full" profile
DATABASE_URL_DOCKER=postgresql://flowforge:flowforge@postgres:5432/flowforge?schema=public

# ── Redis / BullMQ ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────
# Placeholders are rejected when NODE_ENV=production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=7d

# ── Credential encryption (32-byte base64 key) ───────
ENCRYPTION_KEY=

# ── Integrations (demo-safe values only) ─────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000/api/integrations

# ── AI provider ──────────────────────────────────────
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
