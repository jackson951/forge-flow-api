# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173
# Number of trusted reverse-proxy hops in front of the API (0 = none). Set to 1 behind a
# single load balancer so rate limits and audit see the real client IP.
TRUST_PROXY=0
# Defaults to true outside production, false in production
SWAGGER_ENABLED=true

# ── Database ─────────────────────────────────────────
# Local development values only (docker compose). Compose maps Postgres to host port 5433.
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
POSTGRES_DB=flowforge
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5433/flowforge?schema=public
# Connections per process (default 10). Keep (APIs × pool) + (workers × pool) well below
# Postgres max_connections; a worker needs at least WORKER_CONCURRENCY + 2. See docs/backend/21-*.
DATABASE_CONNECTION_LIMIT=
# Used by the api/worker containers in the compose "full" profile
DATABASE_URL_DOCKER=postgresql://flowforge:flowforge@postgres:5432/flowforge?schema=public
# Compose "full" profile only: AI provider for the containers (the fake provider is refused
# in production mode; set to "anthropic" with AI_API_KEY to enable AI steps there).
AI_PROVIDER_DOCKER=
# Worker liveness file for container health checks (set by Compose; leave empty locally).
WORKER_HEARTBEAT_FILE=

# ── Redis / BullMQ ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────
# Placeholders are rejected when NODE_ENV=production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=7d

# ── Credential encryption (Part 17) ──────────────────
# Comma-separated "<keyId>:<base64 of 32 random bytes>"; generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep old keys listed while rotating; run `npm run credentials:reencrypt` after switching.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=

# ── Integrations (demo-safe values only) ─────────────
# GitHub App (docs/backend/10-GITHUB-INTEGRATION.md). Leave empty to disable GitHub.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# base64 of the app's private key PEM:  base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Jira Cloud (Part 25): OAuth 2.0 (3LO) app at developer.atlassian.com/console/myapps.
# Callback: <OAUTH_REDIRECT_BASE_URL>/jira/callback. Webhooks go to
# <PUBLIC_API_URL or the callback host>/api/v1/webhooks/jira (needs a public URL, e.g. ngrok).
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Base of the OAuth callback routes: <base>/slack/callback. Slack requires HTTPS here, so for
# local Slack testing use a tunnel URL, e.g. https://<id>.ngrok-free.app/api/v1/integrations
OAUTH_REDIRECT_BASE_URL=http://localhost:3000/api/v1/integrations
# Browser is sent back here after connecting an integration
FRONTEND_URL=http://localhost:5173

# ── AI provider (Part 12) ────────────────────────────
# anthropic | fake | empty (AI steps disabled). "fake" is deterministic, needs no key,
# and is meant for local demos and tests only.
AI_PROVIDER=
AI_API_KEY=
# Default: claude-haiku-4-5-20251001
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=1024

# ── Development seed (npm run prisma:seed) ───────────
# Optional: lets demo@flowforge.local log in. Leave empty for a locked account.
SEED_DEMO_PASSWORD=

# ── Queue / worker ───────────────────────────────────
QUEUE_PREFIX=flowforge
QUEUE_JOB_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
WORKER_CONCURRENCY=5
NODE_TIMEOUT_MS=30000
# BullMQ job lock: a crashed worker's job is redelivered after about this long
WORKER_LOCK_DURATION_MS=30000
SWEEPER_STALE_AFTER_MS=60000
SWEEPER_INTERVAL_MS=30000
# Steps of one provider (github/slack/microsoft/ai) at once per worker; empty = half of
# WORKER_CONCURRENCY, so one slow provider cannot occupy every slot
PROVIDER_CONCURRENCY=
# Waiting jobs above which manual runs get 429 (webhooks are still accepted); 0 = off
QUEUE_BACKPRESSURE_THRESHOLD=5000

# ── Retention (Part 21) ──────────────────────────────
# Hourly maintenance job; deletes/trims in batches. Payload days must not exceed run days.
RETENTION_ENABLED=true
RETENTION_WEBHOOK_DELIVERY_DAYS=30
RETENTION_STEP_PAYLOAD_DAYS=30
RETENTION_RUN_DAYS=90

# ── Schedule trigger (Part 23) ───────────────────────
# Maintenance job that turns due schedule occurrences into runs (every worker shares it).
SCHEDULE_TICK_INTERVAL_MS=30000
# Missed occurrences: only the latest is run, and only if within this window (≥ 2 ticks)
SCHEDULE_MISFIRE_GRACE_MS=3600000
# Smallest gap between occurrences a schedule may have, in minutes
SCHEDULE_MIN_INTERVAL_MINUTES=5
SCHEDULE_BATCH_SIZE=200

# ── HTTP action and connections (Part 24) ────────────
# User-chosen URLs always pass the egress guard (https only; private, loopback, link-local
# and metadata addresses refused). The two "allow" switches are for dev / self-hosting only.
HTTP_ACTION_ENABLED=true
HTTP_ACTION_ALLOW_PLAIN_HTTP=false
HTTP_ACTION_ALLOW_PRIVATE_NETWORKS=false
HTTP_ACTION_DENIED_PORTS=25,465,587,2375,2376,5432,6379,9200,11211,27017
HTTP_ACTION_DENIED_HOSTS=
HTTP_ACTION_MAX_RESPONSE_BYTES=1048576
HTTP_ACTION_MAX_STORED_BODY_BYTES=49152

# ── Generic inbound webhooks (Part 24) ───────────────
# /api/v1/webhooks/hooks/:hookId — body cap, per-IP and per-workspace limits, rotation grace
WEBHOOK_HOOK_MAX_BODY_BYTES=262144
WEBHOOK_HOOK_PER_IP_PER_MINUTE=60
WEBHOOK_HOOK_DAILY_CAP_PER_WORKSPACE=10000
WEBHOOK_HOOK_ROTATION_GRACE_HOURS=24
# Public API base for webhook URLs shown to users (default: derived from the request)
PUBLIC_API_URL=

# ── HTTP poll trigger (Part 24) ──────────────────────
# Active http.poll triggers per workspace, and polls running at once per worker
HTTP_POLL_MAX_PER_WORKSPACE=20
HTTP_POLL_CONCURRENCY=2
